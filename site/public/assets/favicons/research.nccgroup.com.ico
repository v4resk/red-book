<div class="rte">
    <h2 id="researchactivities" style="position: relative; padding-left: 30px;">Research Activities<span style="position: absolute; left: 0; top: 50%; transform: translateY(-50%); width: 20px; height: 20px; background-color: #5d47d7;"></span></h2>
