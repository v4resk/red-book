											role="combobox"
											id="facet-search-input"
											class="autocomplete-input input control input-lg"
											type="search"
											aria-label="Search Microsoft Learn"
											aria-controls="autocomplete-list"
											aria-expanded="false"
											placeholder="Search Microsoft Learn"
											data-bi-name="home-search"
											data-test-id="home-search-input"
										/>
									</div>
								</div>
							</div>
							<button
								class="button button-primary button-filled button-lg width-full width-auto-tablet"
								type="submit"
								data-bi-name="hero-search-button"
								data-test-id="home-search-button"
							>
								<span class="icon" aria-hidden="true">
									<span class="docon docon-search"></span>
								</span>
								<span>Search</span>
							</button>
						</div>
					</form>
				</div>
			</div>
		</section>
	 
