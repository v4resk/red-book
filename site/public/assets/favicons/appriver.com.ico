on-top section-normal section-clear section-deco section-deco-none\",\"children\":[\"$\",\"div\",null,{\"className\":\"container\",\"children\":[[\"$\",\"header\",null,{\"className\":\"section-header section-header-sub section-header-md\",\"children\":[\"$\",\"div\",null,{\"className\":\"section-header-body \",\"children\":[\"\",[\"$\",\"h2\",null,{\"className\":\"section-header-title \",\"children\":[\"$\",\"span\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"Important resources for customers\"}}]}],[\"$\",\"p\",null,{\"className\":\"section-header-subtitle \",\"children\":\"Although AppRiver is now formally part of the OpenText family, you still have access to the support and account portals you're used to.\"}]]}]}],[\"$\",\"div\",null,{\"className\":\"row\",\"children\":[[\"$\",\"div\",null,{\"className\":\"copy-block-body col-md-10 col-lg-8\",\"children\":[[\"$\",\"p"])</script><script>self.__next_f.push([1,"\",\"0\",{\"children\":[\"$\",\"strong\",null,{\"children\":[\"$\",\"span\",null,{\"style\":{\"fontSize\":\"14pt\"},\"children\":[\"$\",\"a\",null,{\"href\":\"https://account.appriver.com/Account/Login\",\"target\":\"_blank\",\"rel\":\"noopener\",\"children\":\"Secure Cloud Login\"}]}]}]}],\"\\n\",[\"$\",\"p\",\"2\",{\"children\":[[\"$\",\"a\",\"0\",{\"href\":\"https://support.zixcorp.com/\",\"target\":\"_blank\",\"rel\":\"noopener\",\"children\":[\"$\",\"span\",null,{\"style\":{\"fontSize\":\"14pt\"},\"children\":[\"$\",\"strong\",null,{\"children\":\"Support Portal\"}]}]}],[\"$\",\"span\",\"1\",{\"style\":{\"fontSize\":\"14pt\"},\"children\":[\"$\",\"strong\",null,{\"children\":\" \"}]}],\"(Zixcorp.com) \"]}]]}],\"\"]}]]}]}]\n"])</script><script>self.__next_f.push([1,"14:[\"$\",\"section\",null,{\"id\":\"faqs\",\"data-jumplink-title\":\"faqs\",\"className\":\"section section-normal section-normal section-clear section-deco section-deco-none\",\"children\":[\"$\",\"div\",null,{\"className\":\"container\",\"children\":[[\"$\",\"header\",null,{\"className\":\"section-header section-header-sub section-header-md\",\"children\":[\"$\",\"div\",null,{\"className\":\"section-header-body \",\"children\":[\"\",[\"$\",\"h2\",null,{\"className\":\"section-header-title \",\"children\":[\"$\",\"span\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"FAQs (Frequently Asked Questions)\"}}]}],\"\"]}]}],[\"$\",\"div\",null,{\"className\":\"row\",\"children\":[[\"$\",\"div\",null,{\"className\":\"copy-block-body col-md-10 col-lg-8\",\"children\":[[\"$\",\"h3\",\"0\",{\"children\":\"What happened to AppRiver?\"}],\"\\n\",[\"$\",\"p\",\"2\",{\"children\":\"Quick history: AppRiver was acquired by Zix Corporation in 2019. Zix was then acquired by OpenText in 2021. You've been directed to the OpenText Cybersecurity site, which represents the consolidated product \u0026 service portfolios for AppRiver as well as our other products for data security and data protection. \"}],\"\\n\",[\"$\",\"h3\",\"4\",{\"children\":\"What's changed about my account team?\"}],\"\\n\",[\"$\",\"p\",\"6\",{\"children\":[[\"$\",\"em\",\"0\",{\"children\":[\"$\",\"strong\",null,{\"children\":\"Nothing. \"}]}],\"You'll still get the same great service and expertise that you're used to, just with a new brand. (Tip: you should really check out our complete offering.)\"]}],\"\\n\",[\"$\",\"h3\",\"8\",{\"children\":\"What's changed about managing my account?\"}],\"\\n\",[\"$\",\"p\",\"10\",{\"children\":[[\"$\",\"em\",\"0\",{\"children\":[\"$\",\"strong\",null,{\"children\":\"Nothing. \"}]}],\"We've simply consolidated the marketing aspects of the AppRiver website within \",[\"$\",\"a\",\"2\",{\"href\":\"https://cybersecurity.opentext.com/?id=9268_27454\u0026loc=en\",\"children\":\"https://cybersecurity.opentext.com\"}],\", but the existing Secure Cloud portal has stayed in place: \",[\"$\",\"a\",\"4\",{\"href\":\"https://account.appriver.com/identity/login\",\"target\":\"_blank\",\"rel\":\"noopener\",\"children\":\"Secure Cloud Login\"}]]}],\"\\n\",[\"$\",\"h3\",\"12\",{\"children\":\"How do I contact support?\"}],\"\\n\",[\"$\",\"h4\",\"14\",{\"style\":{\"paddingLeft\":\"40px\"},\"children\":\"Encrypted Email Recipients:\"}],\"\\n\",[\"$\",\"p\",\"16\",{\"style\":{\"paddingLeft\":\"40px\"},\"children\":\"Recipients of encrypted email who need assistance should contact the sending organization's support group. This support contact information is provided on the portal login page.\"}],\"\\n\",[\"$\",\"h4\",\"18\",{\"style\":{\"paddingLeft\":\"40px\"},\"children\":\"ZixMail Non-Corporate Customers:\"}],\"\\n\",[\"$\",\"p\",\"20\",{\"style\":{\"paddingLeft\":\"40px\"},\"children\":[\"To open a ticket, please email \",[\"$\",\"a\",\"1\",{\"href\":\"mailto:support@zixcorp.com\",\"rel\":\"nofollow\",\"children\":\"support@zixcorp.com\"}],\". Please allow up to 3 business hours for email responses.\"]}],\"\\n\",[\"$\",\"h4\",\"22\",{\"style\":{\"paddingLeft\":\"40px\"},\"children\":\"Corporate Customers:\"}],\"\\n\",[\"$\",\"p\",\"24\",{\"style\":{\"paddingLeft\":\"40px\"},\"children\":[\"Corporate customer administrators may contact us:\",[\"$\",\"br\",\"1\",{\"children\":\"$undefined\"}],\"by phone (888-576-4949.), \",[\"$\",\"br\",\"3\",{\"children\":\"$undefined\"}],\"by email (\",[\"$\",\"a\",\"5\",{\"href\":\"mailto:support@zixcorp.com\",\"children\":\"support@zixcorp.com\"}],\"), or \",[\"$\",\"br\",\"7\",{\"children\":\"$undefined\"}],\"via the \",[\"$\",\"a\",\"9\",{\"href\":\"https://support.zixcorp.com/\",\"target\":\"_blank\",\"rel\":\"noopener\",\"children\":\"Support Portal\"}],\" (Zixcorp.com).\"]}],\"\\n\",[\"$\",\"h4\",\"26\",{\"style\":{\"paddingLeft\":\"40px\"},\"children\":\"Archive, Encrypt and Protect Customers:\"}],\"\\n\",[\"$\",\"p\",\"28\",{\"style\":{\"paddingLeft\":\"40px\"},\"children\":[\"For non-urgent issues, please email \",[\"$\",\"a\",\"1\",{\"href\":\"mailto:support@zixcorp.com\",\"rel\":\"nofollow\",\"children\":\"support@zixcorp.com\"}],\". We will respond to the email within 3 business hours. For urgent issues, email support or open a ticket via the support portal then call support at 888-576-4949.\"]}],\"\\n\",[\"$\",\"h3\",\"30\",{\"children\":\"How do I use the support portal?\"}],\"\\n\",[\"$\",\"p\",\"32\",{\"children\":\"When you arrive on our support portal, you can immediately access knowledge base articles for questions about email encryption and how to open an encrypted email. You can also access ZixMail user instructions and software downloads of ZixMail. Corporate administrators will need to login for additional knowledgebase articles and software downloads related to ZixGateway and the management of all Zix solutions.\"}],\"\\n\",[\"$\",\"h3\",\"34\",{\"children\":\"What training is available for administrators?\"}],\"\\n\",[\"$\",\"p\",\"36\",{\"children\":\"After deployment, we offer three Tech Talk webinars for additional assistance and refreshers. Please login to the customer support portal to register for the webinars.Additionally, Zix has posted training videos in the ZixGateway section of the support portal.\"}],\"\\n\",[\"$\",\"h3\",\"38\",{\"children\":\"Is there any cost to upgrade or maintain my software?\"}],\"\\n\",[\"$\",\"p\",\"40\",{\"children\":\"All patches, updates and new software releases for Zix are included in your service. There is no cost to upgrade. We recommend the use of latest versions, which are available in the downloads section of our support portal.\"}],\"\\n\",[\"$\",\"h3\",\"42\",{\"children\":\"I received an email notification stating I have received an encrypted email. What do I do next?\"}],\"\\n\",[\"$\",\"p\",\"44\",{\"children\":\"Recipients of encrypted email can get support from the sending organization. The support email address can be found on the login screen when clicking on the encrypted email notification link. If you have any questions about why you received an encrypted email notification or the content of the message, please contact the sender.\"}]]}],\"\"]}]]}]}]\n"])</script><script>self.__n